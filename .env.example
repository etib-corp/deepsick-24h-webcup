# Environment variables — copy to `.env` and fill in real values.
# `.env` is git-ignored; never commit real secrets.

# --- Competitions needs API ---
# Key used by scripts/fetch_new_features.py to read the Webcup needs.
WEBCUP_API_KEY=

# --- Database (MySQL) ---
# docker-compose runs MySQL; these are the container credentials.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=deepsick_nova
MYSQL_PASSWORD=password
MYSQL_DATABASE=deepsick_nova
# Used by the app when running locally (`npm run dev`) against the Docker DB.
# If the password contains reserved URL characters (@ : / ? # %), percent-encode
# them here (e.g. `%` -> `%25`); the raw MYSQL_PASSWORD stays unencoded.
DATABASE_URL="mysql://deepsick_nova:password@localhost:3306/deepsick_nova"
# Hosted MySQL:
# DATABASE_URL="mysql://user:password@host:3306/database"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
