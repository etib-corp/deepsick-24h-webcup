// Terra Nova — Prisma schema.
//
// The docs describe enums, but enum-like fields are stored as plain strings,
// with the allowed values + labels centralised in `lib/roles.ts` and validated
// server-side.
//
// Long free-text fields use the native `@db.Text` type so MySQL does not cap
// them at VARCHAR(191).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String?
  // New arrivals may not have an email address (F71): sign-in then uses
  // `username` — the colon identifier (see `lib/identity.ts`).
  email           String?          @unique
  username        String?          @unique
  passwordHash    String?
  image           String?
  // CITIZEN | SECURITY | MEDIC | MAINTENANCE | DRIVER | MERCHANT | ADMIN_AGENT | COUNCIL
  role            String           @default("CITIZEN")
  sector          String?
  balance         Int              @default(0) // fictional wallet, in credits
  // F53 — when true, signing in additionally requires a one-time code
  // (second step) sent after the password check.
  twoFactorEnabled Boolean         @default(false)
  requests        ServiceRequest[] @relation("RequestAuthor")
  assigned        ServiceRequest[] @relation("RequestAssignee")
  contactMessages ContactMessage[]
  announcements   Announcement[]
  broadcasts      Broadcast[]
  reports         Report[]         @relation("ReportAuthor")
  assignedReports Report[]         @relation("ReportAssignee")
  policeCases     PoliceCase[]     @relation("ArrestingOfficer")
  orders          Order[]
  notifications   Notification[]
  transactions    WalletTransaction[]
  messages        Message[]
  appointments    Appointment[]
  consultations   Consultation[]   @relation("ConsultationAuthor")
  opinions        Opinion[]
  ideas           CitizenIdea[]
  feedbacks       ServiceFeedback[]
  requestSupports RequestSupport[]
  requestReplies  RequestReply[]
  accessCodes     AccessCode[]
  alerts          ColonyAlert[]    @relation("AlertAuthor")
  disruptions     TransitDisruption[] @relation("DisruptionAuthor")
  dataConcerns    DataConcern[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model MunicipalService {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String        @db.Text
  category     String?
  icon         String?
  order        Int           @default(0)
  published    Boolean       @default(true)
  featured     Boolean       @default(false)
  // Position on the stylised colony map (normalised 0..1) + sector label.
  mapX         Float?
  mapY         Float?
  sector       String?
  // Preparation instructions / required documents shown to residents before
  // their appointment (copied onto the booking when an appointment is made).
  preparation  String?        @db.Text
  // Opening hours + physical location shown to residents (F74).
  openingHours String?
  address      String?
  // Clear-language version of the description (F89).
  plainLanguage String?       @db.Text
  appointments Appointment[]
  feedbacks    ServiceFeedback[]
  visits       ServiceVisit[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  body        String    @db.Text
  // Clear-language version of the essential information (F89).
  plainLanguage String? @db.Text
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A prominent, site-wide general announcement ("broadcast") shown as a banner
// to every user while it is active and inside its scheduled time window.
model Broadcast {
  id          String    @id @default(cuid())
  title       String
  message     String    @db.Text
  actionLabel String?
  actionHref  String?   @db.VarChar(255)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A public project opened by the Council for citizen feedback (non-binding).
model Consultation {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String?   @db.Text
  description String    @db.Text
  status      String    @default("OPEN") // OPEN | CLOSED
  published   Boolean   @default(true)
  // When true, staff views hide which citizen wrote each contribution.
  anonymous   Boolean   @default(false)
  // Public, readable outcome written by the Council (shown once closed).
  outcome     String?   @db.Text
  opensAt     DateTime?
  closesAt    DateTime?
  authorId    String?
  author      User?     @relation("ConsultationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  opinions    Opinion[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// A citizen's opinion on a consultation. Not an official vote; one per
// citizen/project (editable). Readable by its author and authorised agents.
model Opinion {
  id             String       @id @default(cuid())
  reference      String       @unique @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stance         String? // SUPPORT | OPPOSE | NEUTRAL
  comment        String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([consultationId, authorId])
  @@index([authorId])
  @@index([consultationId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  reference String   @unique @default(cuid())
  subject   String
  body      String   @db.Text
  email     String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status    String   @default("RECEIVED") // RECEIVED | READ | PROCESSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceRequest {
  id          String               @id @default(cuid())
  reference   String               @unique @default(cuid())
  subject     String
  description String               @db.Text
  category    String?
  priority    String               @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status      String               @default("SUBMITTED") // SUBMITTED | IN_REVIEW | IN_PROGRESS | RESOLVED | CLOSED
  authorId    String
  author      User                 @relation("RequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?                @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  history     RequestStatusEvent[]
  // F52 — when true, the request appears on the community board and other
  // citizens can support it. Off by default: sharing is opt-in.
  shareForSupport Boolean           @default(false)
  replies     RequestReply[]
  supports    RequestSupport[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([authorId])
}

model RequestStatusEvent {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    String
  note      String?        @db.Text
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// ------------------------------------------------------------------
// Terra Nova ecosystem
// ------------------------------------------------------------------

// A citizen signalement routed to a service (security / medical /
// maintenance / cleanliness) and worked through a status lifecycle.
model Report {
  id          String        @id @default(cuid())
  reference   String        @unique @default(cuid())
  type        String // SECURITY | MEDICAL | MAINTENANCE | CLEANLINESS
  title       String
  description String        @db.Text
  priority    String        @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  status      String        @default("OPEN") // OPEN | ASSIGNED | EN_ROUTE | IN_PROGRESS | RESOLVED | CLOSED
  sector      String?
  latitude    Float?
  longitude   Float?
  unit        String?
  authorId    String
  author      User          @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?         @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events      ReportEvent[]
  policeCase  PoliceCase?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status])
  @@index([authorId])
}

model ReportEvent {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status    String
  note      String?  @db.Text
  actorId   String?
  createdAt DateTime @default(now())

  @@index([reportId])
}

// Security case opened from a SECURITY report (arrest + PV, simulated).
model PoliceCase {
  id          String   @id @default(cuid())
  reportId    String   @unique
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  officerId   String
  officer     User     @relation("ArrestingOfficer", fields: [officerId], references: [id])
  suspectName String?
  arrestNotes String?  @db.Text
  fineAmount  Int?
  pvContent   String?  @db.Text
  status      String   @default("OPEN") // OPEN | FILED | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Taxi rides and food orders (Mercator / Hermes).
model Order {
  id          String   @id @default(cuid())
  reference   String   @unique @default(cuid())
  type        String // TAXI | FOOD
  status      String   @default("PENDING")
  summary     String   @db.Text
  total       Int      @default(0)
  etaMinutes  Int?
  origin      String?
  destination String?
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  amount    Int // positive = credit, negative = debit
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?  @db.Text
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Message {
  id        String   @id @default(cuid())
  channel   String
  content   String   @db.Text
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// A rendez-vous booked by a resident against a municipal service (F40).
// Slots are per-service; `status` tracks BOOKED → CANCELLED / COMPLETED and
// `reminderSent` marks whether the pre-appointment reminder was delivered.
model Appointment {
  id              String           @id @default(cuid())
  reference       String           @unique @default(cuid())
  serviceId       String
  service         MunicipalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subject         String?
  citizenId       String
  citizen         User             @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  date            DateTime
  durationMinutes Int              @default(30)
  sector          String?
  status          String           @default("BOOKED") // BOOKED | CANCELLED | COMPLETED
  preparation     String?          @db.Text
  reminderSent    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([citizenId])
  @@index([serviceId, date])
  @@index([date])
}

// ------------------------------------------------------------------
// Participation & community — projects, ideas, support, feedback,
// agent replies (F52, F67, F68, F76, F84)
// ------------------------------------------------------------------

// A city project residents can follow (F67). Public read-only directory,
// managed by the High Council.
model Project {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String?   @db.Text
  description String    @db.Text
  sector      String?
  status      String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED
  progress    Int       @default(0) // 0..100
  startsAt    DateTime?
  endsAt      DateTime?
  published   Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// A free improvement idea proposed by a resident (F68), reviewed by the
// Council with a written response.
model CitizenIdea {
  id         String   @id @default(cuid())
  reference  String   @unique @default(cuid())
  title      String
  body       String   @db.Text
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status     String   @default("SUBMITTED") // SUBMITTED | REVIEWED | PLANNED | DECLINED
  response   String?  @db.Text
  reviewerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([authorId])
}

// One citizen backing a shared request (F52). `@@unique` keeps a single
// support per citizen and per request, so un-supporting is a delete.
model RequestSupport {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([requestId, userId])
  @@index([requestId])
}

// An official reply written by an agent on a request (F84), visible to the
// citizen in their tracking space.
model RequestReply {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String         @db.Text
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// A resident's comment about a municipal service they used (F76). One
// editable comment per citizen and per service.
model ServiceFeedback {
  id        String           @id @default(cuid())
  reference String           @unique @default(cuid())
  serviceId String
  service   MunicipalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comment   String           @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([serviceId, authorId])
  @@index([serviceId])
}

// ------------------------------------------------------------------
// Developer tooling — Webcup needs tracked as tickets
// ------------------------------------------------------------------

// A competition need ("besoin") pulled from the Webcup API and managed as a
// ticket in the dev panel. `status` / `assignee` are local workflow state and
// are never overwritten by a sync.
model Ticket {
  id            String          @id @default(cuid())
  code          String          @unique // D01, F22, …
  title         String          @db.Text
  description   String          @db.Text
  difficulty    String // Facile | Moyenne | Difficile | Expert
  level         Int             @default(1)
  xp            Int             @default(0)
  group         String? // Socle, …
  requester     String?
  requesterType String?
  wave          Int?
  isAi          Boolean         @default(false)
  sortOrder     Int             @default(0)
  status        String          @default("TODO") // TODO | IN_PROGRESS | BLOCKED | REVIEW | DONE
  assignee      String?
  syncedAt      DateTime        @default(now())
  comments      TicketComment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    String
  body      String   @db.Text
  kind      String   @default("COMMENT") // COMMENT | EVENT
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// One row per credential login attempt, used to throttle brute-force attacks.
// `identifier` is the normalized email or `ip:<addr>` so both can be limited.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// Append-only audit trail for sensitive operations: authentication events,
// access denials and privileged actions (roles, content, workflows, case
// files, neutralised inputs). Read by the High Council's security console to
// allow after-the-fact analysis; rows are never updated or deleted by the app.
model SecurityEvent {
  id         String   @id @default(cuid())
  type       String // LOGIN_FAILED | LOGIN_BLOCKED | ACCESS_DENIED | ROLE_CHANGED | CONTENT_CHANGED | REQUEST_STATUS_CHANGED | REPORT_STATUS_CHANGED | ORDER_STATUS_CHANGED | RECORD_ASSIGNED | CASE_FILED | INPUT_NEUTRALIZED | FORM_BLOCKED | ANOMALY_DETECTED | ALERT_REVIEWED
  outcome    String   @default("INFO") // INFO | SUCCESS | DENIED | FLAGGED
  actorId    String?
  actorRole  String?
  targetType String?
  targetId   String?
  detail     String?  @db.Text
  ip         String?
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

// Correlated security alerts produced by the automatic sentinel (F85): unusual
// activity bursts / baseline spikes over `SecurityEvent`, plus inconsistent
// records. Deduplicated by `fingerprint`; reviewed by the High Council and the
// security station. Auto-resolved when the underlying condition disappears.
model SecurityAlert {
  id           String    @id @default(cuid())
  fingerprint  String    @unique // kind:rule:sourceType:sourceId
  kind         String // ANOMALY | INCONSISTENCY
  rule         String // e.g. BURST_LOGIN_FAILED, REQUEST_STATUS_MISMATCH
  severity     String    @default("WARNING") // INFO | WARNING | CRITICAL
  status       String    @default("OPEN") // OPEN | REVIEWED | RESOLVED
  title        String
  detail       String?   @db.Text
  sourceType   String? // ip | actor | request | report | appointment | announcement
  sourceId     String?
  detectedAt   DateTime  @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, severity, detectedAt])
  @@index([kind, detectedAt])
}

// Anti-bot ledger for public forms (F81). The primary key is the random nonce
// carried by the signed form challenge: a submission stores its nonce as
// CONSUMED (accepted) or BLOCKED (refused), so replaying a blocked payload —
// or reusing an accepted challenge — is refused for good. `ip` backs the
// per-address rate limit; rows older than the challenge TTL are pruned.
model BotGuardToken {
  nonce     String   @id
  form      String // contact | register | login
  status    String // CONSUMED | BLOCKED
  ip        String?
  createdAt DateTime @default(now())

  @@index([ip, form, createdAt])
  @@index([createdAt])
}

// ------------------------------------------------------------------
// Difficult batch — access codes, crisis alerts, transit disruptions,
// partners, data concerns, backup drills, service usage (D02, F51, F53,
// F87, F97, F98, F99, F101)
// ------------------------------------------------------------------

// A one-time code for passwordless sign-in (D02) or the second step of a
// two-step login (F53). Only the HMAC of the code is stored; a code is
// single-use, expires after 5 minutes and dies after a few wrong attempts.
model AccessCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String // LOGIN | TWO_STEP
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

// F101 — a colony incident alert (e.g. the north-sector power outage).
// Carries the situation and the instructions to follow, targets a sector
// (null = whole colony) and stays visible until resolved.
model ColonyAlert {
  id           String    @id @default(cuid())
  title        String
  sector       String?
  severity     String    @default("WARNING") // ADVISORY | WARNING | CRITICAL
  situation    String    @db.Text
  instructions String    @db.Text
  status       String    @default("ACTIVE") // ACTIVE | RESOLVED
  startsAt     DateTime?
  resolvedAt   DateTime?
  authorId     String?
  author       User?     @relation("AlertAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

// F97 — an interruption on a shuttle line with the replacement solution
// residents should use while it lasts.
model TransitDisruption {
  id                String    @id @default(cuid())
  lineId            String
  title             String
  message           String    @db.Text
  alternative       String    @db.Text
  alternativeLineId String?
  severity          String    @default("MAJOR") // MINOR | MAJOR | CRITICAL
  active            Boolean   @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  authorId          String?
  author            User?     @relation("DisruptionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([lineId, active])
}

// F99 — an external partner offering services to residents (opening window
// drives the "available now / closed" status shown on the public page).
model Partner {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  category     String?
  description  String   @db.Text
  contact      String?
  actionLabel  String?
  actionHref   String?  @db.VarChar(255)
  openMinutes  Int? // minutes since midnight
  closeMinutes Int?
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// F51 — a concern raised by a resident about how their data is used. Kept
// with a reference and a status so the resident can follow the handling.
model DataConcern {
  id          String   @id @default(cuid())
  reference   String   @unique @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject     String
  body        String   @db.Text
  status      String   @default("RECEIVED") // RECEIVED | REVIEWED | ANSWERED
  response    String?  @db.Text
  responderId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([authorId])
}

// F87 — one backup verification drill: the canonical snapshot checksum and
// the per-dataset report (rows, bytes, checksum, read-back verdict).
model BackupCheck {
  id         String   @id @default(cuid())
  actorId    String?
  status     String // VERIFIED | FAILED
  durationMs Int      @default(0)
  totalRows  Int      @default(0)
  totalSize  Int      @default(0) // bytes of the canonical snapshot
  datasets   String   @db.Text // JSON: [{ key, rows, bytes, checksum, ok }]
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// F98 — aggregated service usage: one row per service and per day, an
// anonymous counter (no user identity is stored).
model ServiceVisit {
  id        String           @id @default(cuid())
  serviceId String
  service   MunicipalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  day       DateTime // UTC midnight
  count     Int              @default(0)
  updatedAt DateTime         @updatedAt

  @@unique([serviceId, day])
  @@index([day])
}
