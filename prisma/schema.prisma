// Terra Nova — Prisma schema.
//
// The docs describe enums, but enum-like fields are stored as plain strings,
// with the allowed values + labels centralised in `lib/roles.ts` and validated
// server-side.
//
// Long free-text fields use the native `@db.Text` type so MySQL does not cap
// them at VARCHAR(191).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  passwordHash    String?
  image           String?
  // CITIZEN | SECURITY | MEDIC | MAINTENANCE | DRIVER | MERCHANT | ADMIN_AGENT | COUNCIL
  role            String           @default("CITIZEN")
  sector          String?
  balance         Int              @default(0) // fictional wallet, in credits
  requests        ServiceRequest[] @relation("RequestAuthor")
  assigned        ServiceRequest[] @relation("RequestAssignee")
  contactMessages ContactMessage[]
  announcements   Announcement[]
  broadcasts      Broadcast[]
  reports         Report[]         @relation("ReportAuthor")
  assignedReports Report[]         @relation("ReportAssignee")
  policeCases     PoliceCase[]     @relation("ArrestingOfficer")
  orders          Order[]
  notifications   Notification[]
  transactions    WalletTransaction[]
  messages        Message[]
  appointments    Appointment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model MunicipalService {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String        @db.Text
  category     String?
  icon         String?
  order        Int           @default(0)
  published    Boolean       @default(true)
  featured     Boolean       @default(false)
  // Position on the stylised colony map (normalised 0..1) + sector label.
  mapX         Float?
  mapY         Float?
  sector       String?
  // Preparation instructions / required documents shown to residents before
  // their appointment (copied onto the booking when an appointment is made).
  preparation  String?       @db.Text
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  body        String    @db.Text
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A prominent, site-wide general announcement ("broadcast") shown as a banner
// to every user while it is active and inside its scheduled time window.
model Broadcast {
  id          String    @id @default(cuid())
  title       String
  message     String    @db.Text
  actionLabel String?
  actionHref  String?   @db.VarChar(255)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  reference String   @unique @default(cuid())
  subject   String
  body      String   @db.Text
  email     String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status    String   @default("RECEIVED") // RECEIVED | READ | PROCESSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceRequest {
  id          String               @id @default(cuid())
  reference   String               @unique @default(cuid())
  subject     String
  description String               @db.Text
  category    String?
  priority    String               @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status      String               @default("SUBMITTED") // SUBMITTED | IN_REVIEW | IN_PROGRESS | RESOLVED | CLOSED
  authorId    String
  author      User                 @relation("RequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?                @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  history     RequestStatusEvent[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([authorId])
}

model RequestStatusEvent {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    String
  note      String?        @db.Text
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// ------------------------------------------------------------------
// Terra Nova ecosystem
// ------------------------------------------------------------------

// A citizen signalement routed to a service (security / medical /
// maintenance / cleanliness) and worked through a status lifecycle.
model Report {
  id          String        @id @default(cuid())
  reference   String        @unique @default(cuid())
  type        String // SECURITY | MEDICAL | MAINTENANCE | CLEANLINESS
  title       String
  description String        @db.Text
  priority    String        @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  status      String        @default("OPEN") // OPEN | ASSIGNED | EN_ROUTE | IN_PROGRESS | RESOLVED | CLOSED
  sector      String?
  latitude    Float?
  longitude   Float?
  unit        String?
  authorId    String
  author      User          @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?         @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events      ReportEvent[]
  policeCase  PoliceCase?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status])
  @@index([authorId])
}

model ReportEvent {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status    String
  note      String?  @db.Text
  actorId   String?
  createdAt DateTime @default(now())

  @@index([reportId])
}

// Security case opened from a SECURITY report (arrest + PV, simulated).
model PoliceCase {
  id          String   @id @default(cuid())
  reportId    String   @unique
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  officerId   String
  officer     User     @relation("ArrestingOfficer", fields: [officerId], references: [id])
  suspectName String?
  arrestNotes String?  @db.Text
  fineAmount  Int?
  pvContent   String?  @db.Text
  status      String   @default("OPEN") // OPEN | FILED | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Taxi rides and food orders (Mercator / Hermes).
model Order {
  id          String   @id @default(cuid())
  reference   String   @unique @default(cuid())
  type        String // TAXI | FOOD
  status      String   @default("PENDING")
  summary     String   @db.Text
  total       Int      @default(0)
  etaMinutes  Int?
  origin      String?
  destination String?
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  amount    Int // positive = credit, negative = debit
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?  @db.Text
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Message {
  id        String   @id @default(cuid())
  channel   String
  content   String   @db.Text
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// A rendez-vous booked by a resident against a municipal service (F40).
// Slots are per-service; `status` tracks BOOKED → CANCELLED / COMPLETED and
// `reminderSent` marks whether the pre-appointment reminder was delivered.
model Appointment {
  id              String           @id @default(cuid())
  reference       String           @unique @default(cuid())
  serviceId       String
  service         MunicipalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subject         String?
  citizenId       String
  citizen         User             @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  date            DateTime
  durationMinutes Int              @default(30)
  sector          String?
  status          String           @default("BOOKED") // BOOKED | CANCELLED | COMPLETED
  preparation     String?          @db.Text
  reminderSent    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([citizenId])
  @@index([serviceId, date])
  @@index([date])
}

// ------------------------------------------------------------------
// Developer tooling — Webcup needs tracked as tickets
// ------------------------------------------------------------------

// A competition need ("besoin") pulled from the Webcup API and managed as a
// ticket in the dev panel. `status` / `assignee` are local workflow state and
// are never overwritten by a sync.
model Ticket {
  id            String          @id @default(cuid())
  code          String          @unique // D01, F22, …
  title         String          @db.Text
  description   String          @db.Text
  difficulty    String // Facile | Moyenne | Difficile | Expert
  level         Int             @default(1)
  xp            Int             @default(0)
  group         String? // Socle, …
  requester     String?
  requesterType String?
  wave          Int?
  isAi          Boolean         @default(false)
  sortOrder     Int             @default(0)
  status        String          @default("TODO") // TODO | IN_PROGRESS | BLOCKED | REVIEW | DONE
  assignee      String?
  syncedAt      DateTime        @default(now())
  comments      TicketComment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    String
  body      String   @db.Text
  kind      String   @default("COMMENT") // COMMENT | EVENT
  createdAt DateTime @default(now())

  @@index([ticketId])
}
